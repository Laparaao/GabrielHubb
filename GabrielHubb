-- 3. PADRE DE LA UI (A PRUEBA DE BALAS)
local function getParent()
    -- Intentamos gethui primero (Delta/Solara)
    local success, hui = pcall(function() return gethui() end)
    if success and hui then return hui end
    
    -- Si falla, usamos CoreGui (Xeno / Universal)
    local success2, cg = pcall(function() return game:GetService("CoreGui") end)
    if success2 and cg then return cg end
    
    -- Último recurso: PlayerGui
    return LocalPlayer:WaitForChild("PlayerGui")
end

