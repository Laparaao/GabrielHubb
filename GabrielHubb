-- ==========================================
-- FUNCIÓN ANTI-TEAMKILL (MUY ESTRICTA)
-- ==========================================
local function isEnemy(p)
    if p == LocalPlayer then return false end
    if not teamCheck then return true end

    -- 1. Revisión por Team (El sistema normal de Roblox)
    if LocalPlayer.Team ~= nil and p.Team ~= nil then
        if LocalPlayer.Team == p.Team then return false end
    end

    -- 2. Revisión por TeamColor (El color del equipo)
    if LocalPlayer.TeamColor ~= nil and p.TeamColor ~= nil then
        if LocalPlayer.TeamColor == p.TeamColor then return false end
    end

    -- 3. Revisión por Atributo (Muchos juegos usan esto)
    local myTeamAttr = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("team")
    local pTeamAttr = p:GetAttribute("Team") or p:GetAttribute("team")
    if myTeamAttr ~= nil and pTeamAttr ~= nil then
        if myTeamAttr == pTeamAttr then return false end
    end

    -- 4. Revisión por nombre de equipo (Por si dice "Policia" o "Ladron")
    if LocalPlayer.Team ~= nil and p.Team ~= nil then
        local myTeamName = string.lower(LocalPlayer.Team.Name)
        local pTeamName = string.lower(p.Team.Name)
        if myTeamName == pTeamName then return false end
    end

    return true
end

