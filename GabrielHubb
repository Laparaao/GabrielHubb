-- LÓGICA DEL HITBOX (TORSO)
local function v32(p3)
	if p3 == LocalPlayer then return end

	local Character = p3.Character
	if not Character then return end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	-- Buscamos el Torso o UpperTorso
	local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
	if not torso then return end

	-- Si el hitbox está apagado, restauramos el tamaño original
	if not (u6 or u7) then
		if t1[p3] then
			torso.Size = t1[p3].OriginalSize
			torso.Transparency = t1[p3].OriginalTransparency
			t1[p3] = nil
		end
		return
	end

	-- Guardamos el tamaño original si no lo hemos hecho
	if not t1[p3] then
		t1[p3] = {
			OriginalSize = torso.Size,
			OriginalTransparency = torso.Transparency
		}
	end

	local originalSize = t1[p3].OriginalSize

	-- Agrandamos el torso
	torso.Size = Vector3.new(
		originalSize.X * n1, 
		originalSize.Y * n1, 
		originalSize.Z * n1
	)

	-- Aplicamos la transparencia (Invisible o no)
	if u7 then
		torso.Transparency = 1
	else
		torso.Transparency = 0
	end
end

-- LIMPIEZA AL SALIR
local function v31(p4)
	local data = t1[p4]
	if not data then return end

	if p4.Character then
		local torso = p4.Character:FindFirstChild("Torso") or p4.Character:FindFirstChild("UpperTorso")
		if torso then
			torso.Size = data.OriginalSize
			torso.Transparency = data.OriginalTransparency
		end
	end

	t1[p4] = nil
end

-- BUCLE PRINCIPAL DEL HITBOX
local function v43()
	if not (u6 or u7) then
		for player, data in pairs(t1) do
			v31(player)
		end
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			v32(player)
		end
	end
end

