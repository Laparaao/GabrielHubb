-- SISTEMA DE CLICKS (BYPASS ANTI-CHEAT)
local buttons = {}
local function registerButton(btn, callback)
    table.insert(buttons, {btn = btn, callback = callback})
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        for _, data in ipairs(buttons) do
            local btn = data.btn
            if btn and btn.Parent and btn.Visible then
                local pos = btn.AbsolutePosition
                local size = btn.AbsoluteSize
                if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
                   mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
                    task.spawn(data.callback)
                    break
                end
            end
        end
    end
end)

