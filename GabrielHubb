-- ==========================================
-- LÓGICA DEL HITBOX (TORSO CON ANCLAJE)
-- ==========================================
local function v32(p3)
	if p3 == LocalPlayer then return end
	local Character = p3.Character
	if not Character then return end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	-- Buscamos el Torso (R6) o UpperTorso (R15)
	local torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
	if not torso then return end

	-- Si se apaga, restauramos
	if not (u6 or u7) then
		if t1[p3] then
			pcall(function()
				torso.Size = t1[p3].OriginalSize
				torso.Transparency = t1[p3].OriginalTransparency
				t1[p3] = nil
			end)
		end
		return
	end

	-- Guardamos el tamaño original
	if not t1[p3] then
		t1[p3] = {
			OriginalSize = torso.Size,
			OriginalTransparency = torso.Transparency
		}
	end

	local originalSize = t1[p3].OriginalSize

	-- TRUCO ANTI-CONGELAMIENTO:
	-- En lugar de multiplicar todo el tamaño, multiplicamos X y Z (ancho y profundidad),
	-- y solo un poco la Y (altura) para que no se separe de las piernas.
	local newSize = Vector3.new(
		originalSize.X * n1, 
		originalSize.Y * (1 + (n1 - 1) * 0.2), -- Crece solo un 20% de lo que crecería en Y
		originalSize.Z * n1
	)

	pcall(function()
		torso.Size = newSize
		torso.Transparency = u7 and 1 or 0
	end)
end

local function v31(p4)
	local data = t1[p4]
	if not data then return end
	pcall(function()
		if p4.Character then
			local torso = p4.Character:FindFirstChild("Torso") or p4.Character:FindFirstChild("UpperTorso")
			if torso then
				torso.Size = data.OriginalSize
				torso.Transparency = data.OriginalTransparency
			end
		end
	end)
	t1[p4] = nil
end

local function v43()
	if not (u6 or u7) then
		for player, data in pairs(t1) do
			v31(player)
		end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			v32(player)
		end
	end
end

RunService.Heartbeat:Connect(function()
