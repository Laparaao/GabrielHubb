-- ==========================================
-- LÓGICA DEL HITBOX (ANTI-CONGELAMIENTO)
-- ==========================================
local function v32(p3)
	if p3 == LocalPlayer then return end
	local Character = p3.Character
	if not Character then return end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	local hrp = Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- Si se apaga, limpiamos la caja
	if not (u6 or u7) then
		if t1[p3] then
			pcall(function()
				if t1[p3].Box then t1[p3].Box:Destroy() end
				if t1[p3].Highlight then t1[p3].Highlight:Destroy() end
			end)
			t1[p3] = nil
		end
		return
	end

	-- Si no existe la caja, la creamos (Local, sin tocar el personaje)
	if not t1[p3] then
		t1[p3] = {}
		
		-- Creamos una parte invisible en el workspace
		local box = Instance.new("Part")
		box.Name = "LocalHitbox_" .. p3.Name
		box.Size = Vector3.new(n1, n1, n1)
		box.Transparency = 1 -- Invisible siempre
		box.CanCollide = false
		box.CanTouch = true
		box.CanQuery = true
		box.Massless = true
		box.Anchored = true -- Lo anclamos y lo movemos por script
		box.Parent = workspace
		
		t1[p3].Box = box
		
		-- El Highlight para que tú lo veas (opcional)
		local highlight = Instance.new("Highlight")
		highlight.Adornee = box
		highlight.FillColor = color3
		highlight.OutlineColor = color3
		highlight.FillTransparency = u7 and 1 or 0.5
		highlight.OutlineTransparency = u7 and 1 or 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = box
		t1[p3].Highlight = highlight
	end

	local box = t1[p3].Box
	local highlight = t1[p3].Highlight

	-- Actualizamos el tamaño de la caja y la pegamos al jugador
	if box and box.Parent then
		box.Size = Vector3.new(n1, n1, n1)
		box.CFrame = hrp.CFrame -- Sigue al jugador en tiempo real
	end

	-- Actualizamos la transparencia del Highlight
	if highlight then
		pcall(function()
			if u7 then
				highlight.FillTransparency = 1
				highlight.OutlineTransparency = 1
			else
				highlight.FillTransparency = 0.5
				highlight.OutlineTransparency = 0
			end
		end)
	end
end

local function v31(p4)
	local data = t1[p4]
	if not data then return end
	pcall(function()
		if data.Box then data.Box:Destroy() end
		if data.Highlight then data.Highlight:Destroy() end
	end)
	t1[p4] = nil
end

local function v43()
	if not (u6 or u7) then
		for player, data in pairs(t1) do
			v31(player)
		end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			v32(player)
		end
	end
end

RunService.Heartbeat:Connect(function()
