-- Función para crear páginas
local function createPage(name)
    local page = Instance.new("Frame")
    page.Name = name
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = CenterPanel
    return page
end

local pageConfig = createPage("ConfigPage")
local pagePlayers = createPage("PlayersPage")
