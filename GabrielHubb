-- ==========================================
-- GABRIEL XITER - VERSIÓN SEGURA (SIN HOOKS)
-- ==========================================
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

if not WindUI then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Error",
        Text = "No se pudo cargar WindUI.",
    })
    return
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local espEnabled, hitboxEnabled = false, false
local hitboxSize = 3
local originalSizes = {}
local espObjects = {}

local aimbotEnabled = false
local autoShootEnabled = false
local aimbotTargetPart = "Head"
local enemyCache = {}

local Window = WindUI:CreateWindow({
    Title = "Gabriel Xiter",
    Icon = "crosshair",
    Author = "Gold Edition",
    Folder = "GabrielXiter",
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark",
    Transparent = true,
    ThemeSettings = {
        Accent = Color3.fromHex("#D4AF37"),
        Background = Color3.fromRGB(22, 22, 22)
    },
    OpenButton = { Title = "Gabriel Xiter", Icon = "crosshair", Enabled = true, Draggable = true }
})

-- ==========================================
-- VISUALES (ESP)
-- ==========================================
local VisualTab = Window:Tab({ Title = "Visuales", Icon = "eye" })
VisualTab:Toggle({
    Title = "ESP Box (Highlight)",
    Default = false,
    Callback = function(state)
        espEnabled = state
        if not state then
            for _, obj in pairs(espObjects) do if obj then obj:Destroy() end end
            espObjects = {}
        end
    end
})

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not espObjects[p] then
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = p.Character
                    highlight.FillColor = Color3.fromHex("#D4AF37")
                    highlight.OutlineColor = Color3.fromHex("#D4AF37")
                    highlight.FillTransparency = 0.5
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = CoreGui
                    espObjects[p] = highlight
                end
            end
        end
    end
end)

-- ==========================================
-- HITBOX
-- ==========================================
local HitboxTab = Window:Tab({ Title = "Hitbox", Icon = "crosshair" })
HitboxTab:Toggle({
    Title = "Activar Hitbox Real",
    Default = false,
    Callback = function(state)
        hitboxEnabled = state
        if not state then
            for p, data in pairs(originalSizes) do
                if p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local torso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
                    if hrp then hrp.Size = data.hrpSize end
                    if torso then torso.Size = data.torsoSize end
                end
            end
            originalSizes = {}
        end
    end
})

HitboxTab:Slider({
    Title = "Tamaño",
    Step = 0.5,
    Value = { Min = 1, Max = 10, Default = 3 },
    Callback = function(value) hitboxSize = value end
})

RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local torso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and torso and humanoid and humanoid.Health > 0 then
                if not originalSizes[p] then
                    originalSizes[p] = { hrpSize = hrp.Size, torsoSize = torso.Size }
                end
                local orig = originalSizes[p]
                torso.Size = Vector3.new(orig.torsoSize.X * hitboxSize, orig.torsoSize.Y, orig.torsoSize.Z * hitboxSize)
                hrp.Size = Vector3.new(orig.hrpSize.X * hitboxSize, orig.hrpSize.Y, orig.hrpSize.Z * hitboxSize)
                if hitboxSize > 2 then torso.Transparency = 1 end
            end
        end
    end
end)

-- ==========================================
-- COMBAT (AIMBOT + AUTO SHOOT)
-- ==========================================
local CombatTab = Window:Tab({ Title = "Combat", Icon = "target" })

CombatTab:Dropdown({
    Title = "Parte del Cuerpo",
    Values = {"Head", "UpperTorso", "HumanoidRootPart"},
    Value = "Head",
    Callback = function(val) aimbotTargetPart = val end
})

CombatTab:Toggle({
    Title = "Aimbot (Camlock)",
    Desc = "Mueve tu cámara al enemigo.",
    Default = false,
    Callback = function(state) aimbotEnabled = state end
})

CombatTab:Toggle({
    Title = "Auto Shoot",
    Desc = "Dispara solo al estar apuntando.",
    Default = false,
    Callback = function(state) autoShootEnabled = state end
})

-- LÓGICA DE AIMBOT (Movimiento de cámara)
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local closestTarget = nil
    local shortestDist = math.huge
    local myPos = Camera.CFrame.Position
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local enemyHum = p.Character:FindFirstChildOfClass("Humanoid")
            if enemyHum and enemyHum.Health > 0 then
                local part = p.Character:FindFirstChild(aimbotTargetPart)
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = part
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closestTarget.Position)
        
        if autoShootEnabled then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Activate() end)
            end
        end
    end
end)

-- ==========================================
-- AJUSTES
-- ==========================================
local SettingsTab = Window:Tab({ Title = "Ajustes", Icon = "settings" })
SettingsTab:Button({
    Title = "Destruir Script",
    Callback = function()
        Window:Destroy()
        for _, obj in pairs(espObjects) do if obj then obj:Destroy() end end
        for p, data in pairs(originalSizes) do
            if p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Size = data.hrpSize end
            end
        end
    end
})

WindUI:Notify({
    Title = "Gabriel Xiter",
    Content = "Script cargado (Modo Seguro).",
    Duration = 5,
    Icon = "check"
})
