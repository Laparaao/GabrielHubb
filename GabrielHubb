local function createCategory(text, yPos)
    local cat = Instance.new("TextLabel")
    cat.Size = UDim2.new(1, -20, 0, 20)
    cat.Position = UDim2.fromOffset(15, yPos)
    cat.BackgroundTransparency = 1
    cat.Text = text
    cat.Font = Enum.Font.GothamBold
    cat.TextSize = 11
    cat.TextColor3 = Colors.TextDim
    cat.TextXAlignment = Enum.TextXAlignment.Left
    cat.Parent = TabContainer
    return cat
end

local function createTab(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.fromOffset(10, yPos)
    btn.BackgroundColor3 = Colors.Sidebar
