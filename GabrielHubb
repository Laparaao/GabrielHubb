-- LÓGICA DEL JUEGO
-- ==========================================
RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local closest, dist = nil, math.huge
            local mouse = UserInputService:GetMouseLocation()
            for _, p in ipairs(Players:GetPlayers()) do
                -- AQUI USAMOS LA NUEVA FUNCIÓN isEnemy()
                if isEnemy(p) and p.Character then
                    local h = p.Character:FindFirstChild("Humanoid")
                    local part = p.Character:FindFirstChild(targetPart)
                    if h and h.Health > 0 and part then
                        local pos, on = Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                            if d < dist and d < fovRadius then
                                dist = d
                                closest = part
                            end
                        end
                    end
                end
            end
            if closest then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closest.Position) end
        end
    end
end)

-- Lógica ESP Seguro
RunService.Heartbeat:Connect(function()
    if not espEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        -- Solo aplicar ESP a enemigos (si el Team Check está activo)
        if isEnemy(p) and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                if not espObjects[p] or not espObjects[p].Parent then
                    local gui = Instance.new("BillboardGui")
                    gui.Name = "SafeESP"
                    gui.Adornee = head
                    gui.Size = UDim2.new(0, 50, 0, 50)
                    gui.StudsOffset = Vector3.new(0, 2, 0)
                    gui.AlwaysOnTop = true
                    gui.Parent = PlayerGui 
                    local frame = Instance.new("Frame")
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
                    frame.BackgroundTransparency = 0.5
                    frame.BorderSizePixel = 0
                    frame.Parent = gui
                    espObjects[p] = gui
                end
            end
        end
    end
end)

-- Lógica Hitbox Visible
RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if not hitboxObjects[p] or not hitboxObjects[p].Parent then
                    local box = Instance.new("Part")
                    box.Name = "VisibleHitbox"
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.Transparency = 0.5 
                    box.Color = Color3.fromRGB(0, 150, 255) 
                    box.Material = Enum.Material.ForceField 
                    box.CanCollide = false
                    box.CanQuery = true
                    box.Anchored = true 
                    box.Parent = workspace 
                    hitboxObjects[p] = box
                end
                local box = hitboxObjects[p]
                if box and box.Parent then
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.CFrame = hrp.CFrame 
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if hitboxObjects[p] then hitboxObjects[p]:Destroy() hitboxObjects[p] = nil end
    if espObjects[p] then espObjects[p]:Destroy() espObjects[p] = nil end
end)

