-- Lógica Hitbox
RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if hrp and humanoid and humanoid.Health > 0 then
                if u6 or u7 then
                    if not t1[player] then
                        local box = Instance.new("Part")
                        box.Name = "HitboxPart"
                        box.Size = Vector3.new(n1, n1, n1)
                        box.Transparency = u7 and 1 or 0.5
                        box.Color = Colors.Accent
                        box.Material = Enum.Material.Neon
                        box.CanCollide = false
                        box.CanTouch = true
                        box.CanQuery = true
                        box.Massless = true
                        box.Anchored = true 
                        box.Parent = workspace
                        
                        local highlight = Instance.new("Highlight")
                        highlight.Adornee = box
                        highlight.FillColor = Colors.Accent
                        highlight.OutlineColor = Colors.Accent
                        highlight.FillTransparency = u7 and 1 or 0.8
                        highlight.OutlineTransparency = u7 and 1 or 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = box
                        
                        t1[player] = {Box = box, Highlight = highlight}
                    end
                    
                    local data = t1[player]
                    if data and data.Box and data.Box.Parent then
                        data.Box.Size = Vector3.new(n1, n1, n1)
                        data.Box.CFrame = hrp.CFrame 
                        data.Box.Transparency = u7 and 1 or 0.5
                        data.Highlight.FillTransparency = u7 and 1 or 0.8
                        data.Highlight.OutlineTransparency = u7 and 1 or 0
                    end
                else
                    if t1[player] then
                        if t1[player].Box then t1[player].Box:Destroy() end
                        t1[player] = nil
                    end
                end
            end
        end
    end
end)

