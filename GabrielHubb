-- Lógica de Botones
HitboxBtn.MouseButton1Click:Connect(function()
    hitboxEnabled = not hitboxEnabled
    HitboxBtn.Text = "Hitbox: " .. (hitboxEnabled and "ON" or "OFF")
    HitboxBtn.BackgroundColor3 = hitboxEnabled and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 40, 40)
    
    if not hitboxEnabled then
        for p, box in pairs(ghostHitboxes) do
            if box then box:Destroy() end
        end
        ghostHitboxes = {}
    end
end)

SizeMinus.MouseButton1Click:Connect(function()
    hitboxSize = math.max(1, hitboxSize - 1)
    SizeLabel.Text = "Tamaño: " .. hitboxSize
end)

SizePlus.MouseButton1Click:Connect(function()
    hitboxSize = math.min(20, hitboxSize + 1)
    SizeLabel.Text = "Tamaño: " .. hitboxSize
end)

AimbotBtn.MouseButton1Click:Connect(function()
    aimbotEnabled = not aimbotEnabled
    AimbotBtn.Text = "Aimbot: " .. (aimbotEnabled and "ON" or "OFF")
    AimbotBtn.BackgroundColor3 = aimbotEnabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(40, 40, 40)
end)

-- ==========================================
-- LÓGICA DE LA HITBOX CUADRADA
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                if not ghostHitboxes[p] or not ghostHitboxes[p].Parent then
                    local box = Instance.new("Part")
                    box.Name = "BoxHitbox"
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.Transparency = 0.5 -- Semi-transparente para que lo veas
                    box.Color = hitboxColor
                    box.Material = Enum.Material.Neon
                    box.CanCollide = false
                    box.CanQuery = true
                    box.CanTouch = true
                    box.Massless = true
                    box.Anchored = true 
                    box.Parent = workspace
                    
                    ghostHitboxes[p] = box
                end
                
                local box = ghostHitboxes[p]
                if box then
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.CFrame = hrp.CFrame 
                end
            end
        end
    end
end)

-- ==========================================
-- LÓGICA DEL AIMBOT
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local closestTarget = nil
    local shortestDist = math.huge
    local myPos = Camera.CFrame.Position
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local enemyHum = p.Character:FindFirstChildOfClass("Humanoid")
            if enemyHum and enemyHum.Health > 0 then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closestTarget.Position)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if ghostHitboxes[p] then
        ghostHitboxes[p]:Destroy()
        ghostHitboxes[p] = nil
    end
end)
