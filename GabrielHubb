    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = Colors.Text
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = TabContainer
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    return btn
end

