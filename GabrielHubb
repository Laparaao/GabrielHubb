-- ==========================================
-- LÓGICA DEL HITBOX
-- ==========================================
task.spawn(function()
    while task.wait(0.1) do -- En Solara, wait más alto evita lag
        if Toggles["Hitbox"] then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local character = player.Character
                    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                    local humanoid = character:FindFirstChild("Humanoid")
                    
                    if torso and humanoid and humanoid.Health > 0 then
                        if not originalSizes[player] then
                            originalSizes[player] = torso.Size
                        end
                        
                        local originalSize = originalSizes[player]
                        torso.Size = Vector3.new(
                            originalSize.X * hitboxSize, 
                            originalSize.Y * hitboxSize, 
                            originalSize.Z * hitboxSize
                        )
                        torso.Transparency = hitboxTransparency / 100
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- LÓGICA DEL ESP
-- ==========================================
task.spawn(function()
    while task.wait(0.1) do
        local espActive = Toggles["ESP Frame"]
        local nameActive = Toggles["ESP Name"]

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local humanoid = character:FindFirstChild("Humanoid")
                local head = character:FindFirstChild("Head")

                if not humanoid or humanoid.Health <= 0 then
                    if espObjects[player] then
                        if espObjects[player].Highlight then espObjects[player].Highlight:Destroy() end
                        if espObjects[player].NameGui then espObjects[player].NameGui:Destroy() end
                        espObjects[player] = nil
                    end
                    continue
                end

                if not espObjects[player] then
                    espObjects[player] = {}
                    
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = character
                    highlight.FillTransparency = 1 
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = ScreenGui
                    espObjects[player].Highlight = highlight

                    local billboard = Instance.new("BillboardGui")
                    billboard.Adornee = head
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = ScreenGui
                    
                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, 0, 1, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = player.Name
                    nameLabel.TextColor3 = espColor
                    nameLabel.TextStrokeTransparency = 0
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextSize = 14
                    nameLabel.Parent = billboard
                    
                    espObjects[player].NameGui = billboard
                    espObjects[player].NameLabel = nameLabel
                end

                local obj = espObjects[player]
                
                if espActive then
                    obj.Highlight.Enabled = true
                    obj.Highlight.OutlineColor = espColor
                else
                    obj.Highlight.Enabled = false
                end

                if nameActive then
                    obj.NameGui.Enabled = true
                    obj.NameLabel.TextColor3 = espColor
                    local dist = math.floor((Camera.CFrame.Position - character.HumanoidRootPart.Position).Magnitude)
                    obj.NameLabel.Text = player.Name .. " [" .. dist .. "m]"
                else
                    obj.NameGui.Enabled = false
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if espObjects[player] then
        if espObjects[player].Highlight then espObjects[player].Highlight:Destroy() end
        if espObjects[player].NameGui then espObjects[player].NameGui:Destroy() end
        espObjects[player] = nil
    end
    if originalSizes[player] then
        originalSizes[player] = nil
    end
end)
