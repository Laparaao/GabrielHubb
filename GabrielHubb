-- GABRIELHUB V2
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- COLORS
local Green = Color3.fromRGB(0, 255, 110)
local Background = Color3.fromRGB(13, 15, 17)
local Panel = Color3.fromRGB(22, 25, 27)
local TextColor = Color3.fromRGB(235, 240, 238)
local Muted = Color3.fromRGB(140, 150, 145)

-- CLEAN OLD GUI
local old = PlayerGui:FindFirstChild("GabrielHubV2")
if old then old:Destroy() end

-- GUI
local Gui = Instance.new("ScreenGui")
Gui.Name = "GabrielHubV2"
Gui.ResetOnSpawn = false
Gui.Parent = PlayerGui

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function label(parent, text, size, position, color)
    local obj = Instance.new("TextLabel")
    obj.Size = size
    obj.Position = position
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.TextColor3 = color or TextColor
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 14
    obj.TextXAlignment = Enum.TextXAlignment.Left
    obj.Parent = parent
    return obj
end

local function button(parent, text, size, position, callback)
    local obj = Instance.new("TextButton")
    obj.Size = size
    obj.Position = position
    obj.BackgroundColor3 = Panel
    obj.BorderSizePixel = 0
    obj.Text = text
    obj.TextColor3 = TextColor
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 12
    obj.Parent = parent
    corner(obj, 7)
    obj.MouseButton1Click:Connect(callback)
    return obj
end

