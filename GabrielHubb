    UDim2.fromOffset(350, 25), UDim2.fromOffset(10, 45),
    Color3.fromRGB(140, 150, 145))

local List = Instance.new("ScrollingFrame")
List.Size = UDim2.new(1, -20, 1, -115)
List.Position = UDim2.fromOffset(10, 85)
List.BackgroundColor3 = Panel
List.BorderSizePixel = 0
List.ScrollBarThickness = 4
List.CanvasSize = UDim2.new()
List.Parent = Whitelist
corner(List, 8)

local Layout = Instance.new("UIListLayout")
Layout.Padding = UDim.new(0, 6)
Layout.Parent = List

local selected = {}

local function refreshPlayers()
    for _, item in ipairs(List:GetChildren()) do
        if item:IsA("Frame") then
            item:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -10, 0, 42)
            row.BackgroundColor3 = Background
            row.BorderSizePixel = 0
            row.Parent = List
            corner(row, 6)

            local name = label(row, player.Name,
                UDim2.new(0.65, 0, 1, 0),
                UDim2.fromOffset(10, 0))

            local selectButton = Instance.new("TextButton")
            selectButton.Size = UDim2.fromOffset(85, 27)
            selectButton.Position = UDim2.new(1, -95, 0.5, -13)
            selectButton.BackgroundColor3 =
                selected[player.UserId] and Green or Panel
            selectButton.Text =
                selected[player.UserId] and "SELECTED" or "SELECT"
            selectButton.TextColor3 =
                selected[player.UserId] and Background or Green
            selectButton.Font = Enum.Font.GothamBold
            selectButton.TextSize = 10
            selectButton.Parent = row
            corner(selectButton, 5)

            selectButton.MouseButton1Click:Connect(function()
                selected[player.UserId] = not selected[player.UserId]
                if not selected[player.UserId] then
                    selected[player.UserId] = nil
                end
                refreshPlayers()
            end)
        end
    end

    task.defer(function()
        List.CanvasSize = UDim2.fromOffset(
            0, Layout.AbsoluteContentSize.Y + 10
        )
    end)
end

local Settings = createPage("Settings")
label(Settings, "Settings", UDim2.fromOffset(300, 35),
    UDim2.fromOffset(10, 10), Green)

label(Settings, "GabrielHub V2",
    UDim2.fromOffset(300, 25), UDim2.fromOffset(10, 55))

local function showPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end
    if name == "Whitelist" then
        refreshPlayers()
    end
end

local menu = {"Home", "Whitelist", "Settings"}

for i, name in ipairs(menu) do
    button(Sidebar, name, UDim2.fromOffset(10, 95 + (i-1)*45),
        function()
            showPage(name)
        end)
end

Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(function(player)
    selected[player.UserId] = nil
    refreshPlayers()
end)

showPage("Home")

print("GabrielHub V2 loaded")
