-- Variables Hitbox
local hitboxEnabled = false
local hitboxInvisible = false
local hitboxSize = 1.5
local hitboxData = {}

local function createToggle(parent, text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.Position = UDim2.fromOffset(10, yPos)
    btn.BackgroundColor3 = Colors.Input
    btn.Text = text .. "  •  OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = Colors.Text
    btn.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    local isOn = false
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        btn.Text = text .. "  •  " .. (isOn and "ON" or "OFF")
        btn.TextColor3 = isOn and Colors.Green or Colors.Text
        callback(isOn)
    end)
end

createToggle(pagePlayers, "Hitbox Torso", 40, function(state)
    hitboxEnabled = state
end)

createToggle(pagePlayers, "Hitbox Invisible", 80, function(state)
    hitboxInvisible = state
end)

