-- ==========================================
-- SISTEMA DE CLIC GLOBAL (ANTI-BLOQUEO)
-- ==========================================
local buttons = {} -- Aquí guardamos todos los botones y sus acciones

local function registerButton(btn, callback, name)
    btn.Name = name
    table.insert(buttons, {btn = btn, callback = callback, name = name})
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Ignorar clics en la UI del juego
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        
        for _, data in ipairs(buttons) do
            local btn = data.btn
            if btn.Visible and btn.Parent and btn.Parent.Parent then -- Verificar que el botón exista y sea visible
                local pos = btn.AbsolutePosition
                local size = btn.AbsoluteSize
                
                -- Calcular si el clic está dentro del botón
                if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
                   mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
                    
                    DebugLabel.Text = "CLICK DETECTADO EN: " .. data.name
                    task.spawn(data.callback)
                    break
                end
            end
        end
    end
end)

