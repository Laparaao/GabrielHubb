-- ==========================================
-- LÓGICA DEL HITBOX (SIN CONGELAR)
-- ==========================================
RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
            
            if torso then
                if hitboxEnabled then
                    if not hitboxData[player] then
                        hitboxData[player] = { OriginalSize = torso.Size, OriginalTransparency = torso.Transparency }
                    end
                    
                    local origSize = hitboxData[player].OriginalSize
                    -- Fórmula para no congelar
                    torso.Size = Vector3.new(origSize.X * hitboxSize, origSize.Y * (1 + (hitboxSize - 1) * 0.2), origSize.Z * hitboxSize)
                    torso.Transparency = hitboxInvisible and 1 or 0
                else
                    if hitboxData[player] then
                        torso.Size = hitboxData[player].OriginalSize
                        torso.Transparency = hitboxData[player].OriginalTransparency
                        hitboxData[player] = nil
                    end
                end
            end
        end
    end
end)

