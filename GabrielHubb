Content.Position = UDim2.fromOffset(160, 10)
Content.BackgroundTransparency = 1
Content.Parent = Main

local Pages = {}

local function createPage(name)
    local page = Instance.new("Frame")
    page.Name = name
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = Content
    Pages[name] = page
    return page
end

local function label(parent, text, size, position, color)
    local obj = Instance.new("TextLabel")
    obj.Size = size
    obj.Position = position
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.TextColor3 = color or TextColor
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 15
    obj.TextXAlignment = Enum.TextXAlignment.Left
    obj.Parent = parent
    return obj
end

local function button(parent, text, position, callback)
    local obj = Instance.new("TextButton")
    obj.Size = UDim2.fromOffset(135, 35)
    obj.Position = position
    obj.BackgroundColor3 = Panel
    obj.BorderSizePixel = 0
    obj.Text = text
    obj.TextColor3 = TextColor
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 12
    obj.Parent = parent
    corner(obj, 7)
    obj.MouseButton1Click:Connect(callback)
    return obj
end

local Home = createPage("Home")
label(Home, "Dashboard", UDim2.fromOffset(300, 35),
