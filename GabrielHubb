-- 4. FUNCIONES DE CREACIÓN DE ELEMENTOS
-- ==========================================
local function createLabel(parent, text, size, pos, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = size
    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color or Theme.TextColor
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent
    return lbl
end

local function createButton(parent, text, size, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Theme.Panel
    btn.TextColor3 = Theme.TextColor
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Text = text
    btn.BorderSizePixel = 0
    btn.Parent = parent
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function createToggle(parent, title, yPos)
    local enabled = false
    createLabel(parent, title, UDim2.new(0, 200, 0, 30), UDim2.new(0, 15, 0, yPos), Theme.TextColor)
    local btn = createButton(parent, "OFF", UDim2.new(0, 80, 0, 25), UDim2.new(0, 230, 0, yPos), function()
        enabled = not enabled
        btn.Text = enabled and "ON" or "OFF"
        btn.BackgroundColor3 = enabled and Theme.Green or Theme.Panel
        btn.TextColor3 = enabled and Theme.Background or Theme.TextColor
        Toggles[title] = enabled
    end)
    return enabled
end

