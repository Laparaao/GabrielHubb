-- SISTEMA DE CLIC POR POSICIÓN (BYPASS)
-- ==========================================
local buttons = {}

local function registerButton(btn, callback)
    table.insert(buttons, {btn = btn, callback = callback})
end

-- Escuchar clics globales
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- En algunos juegos, gameProcessed es true incluso en la UI, así que lo ignoramos
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        
        for _, data in ipairs(buttons) do
            local btn = data.btn
            -- Verificar que el botón y su padre sean visibles
            if btn and btn.Parent and btn.Parent.Parent and btn.Visible and btn.Parent.Visible then
                local pos = btn.AbsolutePosition
                local size = btn.AbsoluteSize
                
                -- Comprobar si el clic está dentro del botón
                if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
                   mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
                    
                    task.spawn(data.callback)
                    break
                end
            end
        end
    end
end)

