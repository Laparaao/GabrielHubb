-- ==========================================
-- GABRIEL XITER - WINDUI PRO (HITBOX REAL)
-- ==========================================
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

if not WindUI then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Error",
        Text = "No se pudo cargar WindUI.",
    })
    return
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local espEnabled = false
local espObjects = {}
local hitboxEnabled = false
local hitboxSize = 3 -- Multiplicador (3 = triple de grande)
local originalSizes = {} -- Para guardar el tamaño original

local Window = WindUI:CreateWindow({
    Title = "Gabriel Xiter",
    Icon = "swords",
    Author = "Duelos Edition",
    Folder = "GabrielXiter",
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark",
    Transparent = true,
    ThemeSettings = {
        Accent = Color3.fromRGB(255, 80, 150),
        Background = Color3.fromRGB(22, 22, 22)
    },
    OpenButton = { Title = "Gabriel Xiter", Icon = "swords", Enabled = true, Draggable = true }
})

-- ==========================================
-- PESTAÑA: VISUALES (ESP)
-- ==========================================
local VisualTab = Window:Tab({ Title = "Visuales", Icon = "eye" })

VisualTab:Toggle({
    Title = "ESP Box (Highlight)",
    Default = false,
    Callback = function(state)
        espEnabled = state
        if not state then
            for _, obj in pairs(espObjects) do if obj then obj:Destroy() end end
            espObjects = {}
        end
    end
})

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not espObjects[p] then
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = p.Character
                    highlight.FillColor = Color3.fromRGB(255, 80, 150)
                    highlight.OutlineColor = Color3.fromRGB(255, 80, 150)
                    highlight.FillTransparency = 0.5
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = CoreGui
                    espObjects[p] = highlight
                end
            end
        end
    end
end)

-- ==========================================
-- PESTAÑA: HITBOX (MULTIPLICADOR REAL)
-- ==========================================
local HitboxTab = Window:Tab({ Title = "Hitbox", Icon = "crosshair" })

HitboxTab:Toggle({
    Title = "Activar Hitbox Real",
    Desc = "Agranda el cuerpo del enemigo para que las balas conecten.",
    Default = false,
    Callback = function(state)
        hitboxEnabled = state
        -- Si se apaga, devolvemos los cuerpos a la normalidad
        if not state then
            for p, data in pairs(originalSizes) do
                if p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local torso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
                    if hrp then hrp.Size = data.hrpSize end
                    if torso then torso.Size = data.torsoSize end
                end
            end
            originalSizes = {}
        end
    end
})

HitboxTab:Slider({
    Title = "Multiplicador de Tamaño",
    Desc = "2 = Doble de grande. 3 = Triple.",
    Step = 0.5,
    Value = { Min = 1, Max = 10, Default = 3 },
    Callback = function(value)
        hitboxSize = value
    end
})

-- Lógica del Hitbox Real (Anti-Congelamiento)
RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local torso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            
            if hrp and torso and humanoid and humanoid.Health > 0 then
                -- Guardamos el tamaño original (solo la primera vez)
                if not originalSizes[p] then
                    originalSizes[p] = {
                        hrpSize = hrp.Size,
                        torsoSize = torso.Size
                    }
                end
                
                local orig = originalSizes[p]
                
                -- 1. Agrandamos el Torso (Para que se vea grande, pero sin estirar la Y para no congelar)
                torso.Size = Vector3.new(
                    orig.torsoSize.X * hitboxSize,
                    orig.torsoSize.Y, -- La altura se queda igual
                    orig.torsoSize.Z * hitboxSize
                )
                
                -- 2. Agrandamos el HumanoidRootPart (Que es el que detecta las balas del servidor)
                hrp.Size = Vector3.new(
                    orig.hrpSize.X * hitboxSize,
                    orig.hrpSize.Y,
                    orig.hrpSize.Z * hitboxSize
                )
                
                -- Hacemos el torso invisible si el multiplicador es muy grande para no tapar la pantalla
                if hitboxSize > 2 then
                    torso.Transparency = 1
                end
            end
        end
    end
end)

-- ==========================================
-- PESTAÑA: AJUSTES
-- ==========================================
local SettingsTab = Window:Tab({ Title = "Ajustes", Icon = "settings" })
SettingsTab:Button({
    Title = "Destruir Script",
    Callback = function()
        Window:Destroy()
        for _, obj in pairs(espObjects) do if obj then obj:Destroy() end end
        for p, data in pairs(originalSizes) do
            if p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Size = data.hrpSize end
            end
        end
    end
})

WindUI:Notify({
    Title = "Gabriel Xiter",
    Content = "Hitbox Real cargada.",
    Duration = 5,
    Icon = "check"
})
