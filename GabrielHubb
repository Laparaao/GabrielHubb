local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

if not WindUI then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Error",
        Text = "No se pudo cargar WindUI. Revisa tu conexión.",
    })
    return
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Variables de estado
local espEnabled = false
local espObjects = {}
local hitboxEnabled = false
local hitboxSize = 5
local hitboxTransparency = 0.5
local hitboxData = {}

-- Crear Ventana
local Window = WindUI:CreateWindow({
    Title = "Gabriel Xiter",
    Icon = "swords",
    Author = "Duelos Edition",
    Folder = "GabrielXiter",
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark",
    Transparent = true,
    ThemeSettings = {
        Accent = Color3.fromRGB(255, 80, 150), -- Tu color rosa
        Background = Color3.fromRGB(22, 22, 22)
    }
})

-- ==========================================
-- PESTAÑA: VISUALES (ESP)
-- ==========================================
local VisualTab = Window:Tab({ Title = "Visuales", Icon = "eye" })

VisualTab:Toggle({
    Title = "ESP Box (Highlight)",
    Desc = "Muestra un cuadro brillante alrededor de los enemigos.",
    Default = false,
    Callback = function(state)
        espEnabled = state
        if not state then
            for _, obj in pairs(espObjects) do
                if obj then obj:Destroy() end
            end
            espObjects = {}
        end
    end
})

-- Lógica del ESP
RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not espObjects[player] then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = player.Character
                highlight.FillColor = Color3.fromRGB(255, 80, 150)
                highlight.OutlineColor = Color3.fromRGB(255, 80, 150)
                highlight.FillTransparency = 0.5
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = game:GetService("CoreGui")
                espObjects[player] = highlight
            end
        end
    end
end)

-- ==========================================
-- PESTAÑA: HITBOX
-- ==========================================
local HitboxTab = Window:Tab({ Title = "Hitbox", Icon = "crosshair" })

HitboxTab:Toggle({
    Title = "Activar Hitbox",
    Desc = "Crea un cuadro invisible para facilitar los tiros.",
    Default = false,
    Callback = function(state)
        hitboxEnabled = state
        if not state then
            for _, data in pairs(hitboxData) do
                if data.Box then data.Box:Destroy() end
            end
            hitboxData = {}
        end
    end
})

HitboxTab:Slider({
    Title = "Tamaño",
    Desc = "Tamaño de la caja.",
    Step = 1,
    Value = { Min = 1, Max = 20, Default = 5 },
    Callback = function(value)
        hitboxSize = value
    end
})

HitboxTab:Slider({
    Title = "Transparencia",
    Desc = "0 es sólido, 1 es invisible.",
    Step = 0.1,
    Value = { Min = 0, Max = 1, Default = 0.5 },
    Callback = function(value)
        hitboxTransparency = value
    end
})

-- Lógica de la Hitbox
RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                if not hitboxData[player] then
                    local box = Instance.new("Part")
                    box.Name = "GabrielHitbox"
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.Transparency = hitboxTransparency
                    box.Color = Color3.fromRGB(255, 80, 150)
                    box.Material = Enum.Material.Neon
                    box.CanCollide = false
                    box.CanQuery = true
                    box.Massless = true
                    box.Anchored = true 
                    box.Parent = workspace
                    
                    hitboxData[player] = {Box = box}
                end
                
                local data = hitboxData[player]
                if data and data.Box and data.Box.Parent then
                    data.Box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    data.Box.Transparency = hitboxTransparency
                    data.Box.CFrame = hrp.CFrame 
                end
            end
        end
    end
end)

-- ==========================================
-- PESTAÑA: AJUSTES
-- ==========================================
local SettingsTab = Window:Tab({ Title = "Ajustes", Icon = "settings" })

SettingsTab:Button({
    Title = "Destruir Script",
    Desc = "Cierra la interfaz y apaga todo.",
    Callback = function()
        Window:Destroy()
        for _, obj in pairs(espObjects) do if obj then obj:Destroy() end end
        for _, data in pairs(hitboxData) do if data.Box then data.Box:Destroy() end end
    end
})

-- Mensaje de carga
WindUI:Notify({
    Title = "Gabriel Xiter",
    Content = "Script cargado correctamente.",
    Duration = 5,
    Icon = "check"
})
