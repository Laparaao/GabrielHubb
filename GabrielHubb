-- NAVIGATION
local menu = {
    "Home",
    "Hitbox",
    "ESP",
    "Whitelist",
    "Movement",
    "Settings"
}

local function showPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    if name == "Whitelist" then
        refreshPlayers()
    end
end

for i, name in ipairs(menu) do
    button(
        Sidebar,
        name,
        UDim2.fromOffset(135, 35),
        UDim2.fromOffset(10, 80 + (i - 1) * 43),
        function()
            showPage(name)
        end
    )
end

