-- Lógica de cambio de pestañas
local function switchPage(pageToShow)
    for _, child in pairs(CenterPanel:GetChildren()) do
        if child:IsA("Frame") then
            child.Visible = false
        end
    end
    pageToShow.Visible = true
end

