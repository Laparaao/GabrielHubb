-- FUNCIONES DE CREACIÓN (SOLARA FIX)
-- ==========================================
local function createLabel(parent, text, size, pos, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = size; lbl.Position = pos; lbl.BackgroundTransparency = 1
    lbl.Text = text; lbl.TextColor3 = color or Theme.TextColor
    lbl.Font = Enum.Font.Gotham; lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = parent
    return lbl
end

local function createButton(parent, text, size, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = size; btn.Position = pos
    btn.BackgroundColor3 = Theme.Panel; btn.TextColor3 = Theme.TextColor
    btn.Font = Enum.Font.GothamSemibold; btn.TextSize = 12
    btn.Text = text; btn.BorderSizePixel = 0; btn.Parent = parent
    btn.AutoButtonColor = true
    
    -- SOLARA FIX: Usar InputBegan que es más confiable en Solara que MouseButton1Click
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            task.spawn(callback)
        end
    end)
    
    return btn
end

local function createToggle(parent, title, yPos)
    createLabel(parent, title, UDim2.new(0, 200, 0, 30), UDim2.new(0, 15, 0, yPos), Theme.TextColor)
    
    local btn = createButton(parent, "OFF", UDim2.new(0, 80, 0, 25), UDim2.new(0, 230, 0, yPos), function()
        Toggles[title] = not Toggles[title]
        btn.Text = Toggles[title] and "ON" or "OFF"
        btn.BackgroundColor3 = Toggles[title] and Theme.Green or Theme.Panel
        btn.TextColor3 = Toggles[title] and Theme.Background or Theme.TextColor
        
        if title == "Hitbox" and not Toggles[title] then
            for player, originalSize in pairs(originalSizes) do
                if player.Character then
                    local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
                    if torso then
                        torso.Size = originalSize
                        torso.Transparency = 0
                    end
                end
            end
            originalSizes = {}
        end
    end)
    
    btn.BackgroundColor3 = Toggles[title] and Theme.Green or Theme.Panel
    btn.TextColor3 = Toggles[title] and Theme.Background or Theme.TextColor
end

