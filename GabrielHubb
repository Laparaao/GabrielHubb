-- Lógica
RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local closest, dist = nil, math.huge
            local mouse = UserInputService:GetMouseLocation()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and not (teamCheck and p.Team == LocalPlayer.Team) then
                    local h = p.Character:FindFirstChild("Humanoid")
                    local part = p.Character:FindFirstChild(targetPart)
                    if h and h.Health > 0 and part then
                        local pos, on = Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                            if d < dist and d < fovRadius then
                                dist = d
                                closest = part
                            end
                        end
                    end
                end
            end
            if closest then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closest.Position) end
        end
    end

    if espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not p.Character:FindFirstChild("Highlight") then
                local hl = Instance.new("Highlight")
                hl.Adornee = p.Character
                hl.FillColor = Color3.fromRGB(0, 150, 255)
                hl.FillTransparency = 0.5
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = p.Character
            end
        end
    end
end)

-- LÓGICA DE HITBOX ANTI-PING (WELD Y PREDICCIÓN)
RunService.Heartbeat:Connect(function()
    if not hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                if not hitboxObjects[p] or not hitboxObjects[p].Box.Parent then
                    local box = Instance.new("Part")
                    box.Name = "PingHitbox"
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.Transparency = hitboxVisible and 0.5 or 1
                    box.Color = Color3.fromRGB(0, 150, 255)
                    box.Material = Enum.Material.Neon
                    box.CanCollide = false
                    box.CanQuery = true
                    box.Anchored = false -- Importante para el Weld
                    box.Massless = true
                    box.Parent = workspace
                    
                    -- Soldamos la caja al enemigo
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = hrp
                    weld.Part1 = box
                    weld.Parent = box
                    
                    hitboxObjects[p] = {Box = box, Weld = weld}
                end
                
                local box = hitboxObjects[p].Box
                if box then
                    -- Aplicamos un pequeño "lag compensation" (predictivo)
                    local velocity = hrp.AssemblyLinearVelocity
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.Transparency = hitboxVisible and 0.5 or 1
                    -- Movemos la caja un 20% hacia donde va el enemigo (compensa el ping)
                    box.CFrame = hrp.CFrame + (velocity * 0.05) 
                end
            end
        end
    end
end)

