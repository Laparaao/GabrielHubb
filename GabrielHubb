local List = Instance.new("ScrollingFrame")
List.Size = UDim2.new(1, -20, 1, -85)
List.Position = UDim2.fromOffset(10, 75)
List.BackgroundColor3 = Panel
List.BorderSizePixel = 0
List.ScrollBarThickness = 4
List.CanvasSize = UDim2.new()
List.Parent = Whitelist
corner(List, 8)

local Layout = Instance.new("UIListLayout")
Layout.Padding = UDim.new(0, 6)
Layout.Parent = List

local selected = {}

local function refreshPlayers()
    for _, item in ipairs(List:GetChildren()) do
        if item:IsA("Frame") then
            item:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -10, 0, 42)
            row.BackgroundColor3 = Background
            row.BorderSizePixel = 0
            row.Parent = List
            corner(row, 6)

            label(row, player.Name,
                UDim2.new(0.65, 0, 1, 0),
                UDim2.fromOffset(10, 0))

            local selectButton = button(
                row,
                selected[player.UserId] and "SELECTED" or "SELECT",
                UDim2.fromOffset(85, 27),
                UDim2.new(1, -95, 0.5, -13),
                function()
                    selected[player.UserId] =
                        not selected[player.UserId] or nil
                    refreshPlayers()
                end
            )

            if selected[player.UserId] then
                selectButton.BackgroundColor3 = Green
                selectButton.TextColor3 = Background
            end
        end
    end

    task.defer(function()
        List.CanvasSize = UDim2.fromOffset(
            0, Layout.AbsoluteContentSize.Y + 10
        )
    end)
end

