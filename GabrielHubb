-- Lógica de la Hitbox Visible
RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChild("Humanoid")

            if hrp and humanoid and humanoid.Health > 0 then
                if hitboxEnabled then
                    if not hitboxData[player] then
                        local box = Instance.new("Part")
                        box.Name = "HitboxPart"
                        box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        
                        -- AQUÍ ESTÁ EL CAMBIO PARA QUE SEA VISIBLE
                        box.Transparency = 0.5 -- 0 es sólido, 1 es invisible. 0.5 es semitransparente
                        box.Color = Colors.Green -- Color verde
                        box.Material = Enum.Material.Neon -- Material brillante (opcional)
                        
                        box.CanCollide = false
                        box.CanTouch = true
                        box.CanQuery = true
                        box.Massless = true
                        box.Anchored = true 
                        box.Parent = workspace
                        
                        -- Un Highlight para que se vea el borde a través de las paredes
                        local highlight = Instance.new("Highlight")
                        highlight.Adornee = box
                        highlight.FillColor = Colors.Green
                        highlight.OutlineColor = Colors.Green
                        highlight.FillTransparency = 0.8 -- El interior del highlight más transparente
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = box
                        
                        hitboxData[player] = {Box = box, Highlight = highlight}
                    end
                    
                    local data = hitboxData[player]
                    if data and data.Box and data.Box.Parent then
                        data.Box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        data.Box.CFrame = hrp.CFrame 
                    end
                else
                    if hitboxData[player] then
                        if hitboxData[player].Box then hitboxData[player].Box:Destroy() end
                        hitboxData[player] = nil
                    end
                end
            end
        end
    end
end)

