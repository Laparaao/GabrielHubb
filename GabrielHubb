-- Switch
local function createSwitch(parent, text, y, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -20, 0, 30)
    f.Position = UDim2.fromOffset(10, y)
    f.BackgroundTransparency = 1
    f.Parent = parent

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.7, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextColor3 = Color3.fromRGB(200, 200, 200)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromOffset(34, 18)
    bg.Position = UDim2.new(1, -34, 0.5, -9)
    bg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    bg.Parent = f
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(14, 14)
    dot.Position = UDim2.fromOffset(2, 2)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    dot.Parent = bg
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local on = false
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            on = not on
            bg.BackgroundColor3 = on and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(60, 60, 60)
            dot.Position = on and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
            cb(on)
        end
    end)
end

